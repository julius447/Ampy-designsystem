{
  "file": "kallor/Energycalc/vB/index.html",
  "out": "inventering/_probes/energycalc.measure.json",
  "scope": ".page",
  "cssVars": ["--teal", "--teal-bright", "--teal-on-dark", "--midnight", "--mist", "--ink", "--muted", "--line", "--line2", "--mint", "--neon", "--slate", "--inset", "--chip", "--eyebrow", "--subtext", "--footnote", "--pagebg", "--amber", "--bar-house", "--sp-1", "--sp-2", "--sp-3", "--sp-4", "--sp-5", "--sp-6", "--sp-7", "--sp-8", "--sp-9", "--shell-max", "--ty-display", "--ty-h", "--ty-lead", "--ty-sub", "--ty-body", "--ty-label", "--ty-eyebrow", "--ty-micro", "--r-xs", "--r-sm", "--r-md", "--r-lg", "--r-xl", "--shadow-1", "--shadow-2", "--shadow-3", "--shadow-teal", "--ring-light", "--ring-dark", "--ease", "--ease-out", "--t-fast", "--t-mid", "--t-slow", "--aurora"],
  "before": [
    {"key": "pseudo", "evalStore": "(() => { const g = (sel, p) => { const el = document.querySelector(sel); if (!el) return null; const cs = getComputedStyle(el, p); return { h: cs.height, w: cs.width, bg: cs.backgroundColor, bgi: cs.backgroundImage.slice(0, 400), radius: cs.borderRadius, shadow: cs.boxShadow, border: cs.border, marginTop: cs.marginTop, content: cs.content }; }; return { rangeTrack: g('.range', '::-webkit-slider-runnable-track'), rangeThumb: g('.range', '::-webkit-slider-thumb'), resultBefore: g('.result', '::before'), resultAfter: g('.result', '::after'), eyebrowBefore: g('.eyebrow', '::before'), trustAfter: g('.trust', '::after') }; })()"}
  ],
  "roles": {
    "body": "body",
    "page": ".page",
    "panes": ".panes",
    "input-card": ".input",
    "rightcol": ".rightcol",
    "gearhead": ".gearhead",
    "hp-legend": ".hp-legend",
    "hp-legend-soft": ".hp-legend-soft",
    "hp-grid": ".hp-grid",
    "hp-card": ".hp-card[aria-pressed='false']:not(.hp-card--quiet)",
    "hp-card-pressed": ".hp-card[aria-pressed='true']",
    "hp-ic": ".hp-card[aria-pressed='false'] .hp-ic",
    "hp-ic-pressed": ".hp-card[aria-pressed='true'] .hp-ic",
    "hp-lbl": ".hp-card[aria-pressed='false'] .hp-lbl",
    "hp-check": ".hp-card[aria-pressed='true'] .hp-check",
    "hp-card-quiet": ".hp-card--quiet",
    "lbl": ".lbl",
    "lbl-val": ".lbl-val",
    "lbl-soft": ".lbl-soft",
    "antag": ".antag",
    "range": "#areaSlider",
    "seg": "#priceAreaSeg",
    "seg-pill": "#priceAreaSeg .seg-pill",
    "seg-btn": "#priceAreaSeg button:not(.on)",
    "seg-btn-on": "#priceAreaSeg button.on",
    "seg-wrap-btn": "#eraSeg button:not(.on)",
    "stepper": ".stepper",
    "stepbtn": ".stepbtn",
    "stepval": ".stepval",
    "gear-n2": ".gear[data-gear='n2']",
    "result": ".result",
    "eyebrow": ".eyebrow",
    "anchor-num": ".anchor-num",
    "anchor-per": ".anchor-per",
    "storybar": ".storybar",
    "sb-heat": ".sb-heat",
    "sb-vv": ".sb-vv",
    "sb-house": ".sb-house",
    "sb-legend": ".sb-legend",
    "sb-legend-li": ".sb-legend li",
    "sb-legend-b": ".sb-legend b",
    "sb-dot": ".sb-dot",
    "spark": ".spark",
    "spark-h": ".spark-h",
    "spark-list": ".spark-list",
    "sp-item": ".sp-item:not(.is-rec):not(.is-off)",
    "sp-item-rec": ".sp-item.is-rec",
    "sp-item-off": ".sp-item.is-off",
    "sp-row": ".sp-item.is-rec .sp-row",
    "sp-flag": ".sp-flag:not([hidden])",
    "sp-name-rec": ".sp-item.is-rec .sp-name",
    "sp-name": ".sp-item:not(.is-rec) .sp-name",
    "sp-val": ".sp-item.is-rec .sp-val",
    "sp-val-soft": ".sp-val--soft",
    "sp-track": ".sp-item.is-rec .sp-track",
    "sp-fill": ".sp-item.is-rec .sp-fill",
    "sp-band": ".sp-item.is-rec .sp-band",
    "sp-pay": ".sp-pay",
    "sp-caret": ".sp-caret",
    "sp-drop-body": ".sp-item.is-rec .sp-drop-body",
    "sp-statrow": ".sp-statrow + .sp-statrow",
    "sp-statrow-k": ".sp-statrow-k",
    "sp-statrow-v": ".sp-statrow-v",
    "ctablock": ".ctablock",
    "cta": "#ctaBtn",
    "share-btn": "#shareBtn",
    "method": ".method",
    "method-summary": ".method summary",
    "trust": ".trust",
    "trust-inner": ".trust-inner",
    "trust-quote-p": ".trust-quote p",
    "trust-mark": ".trust-mark",
    "trust-cite": ".trust-cite",
    "trust-star": ".trust-stars svg",
    "trust-rating-txt": ".trust-rating-txt",
    "trust-divider": ".trust-divider",
    "trust-stat": ".trust-stat",
    "jump-pill": ".jump-pill",
    "jp-chip": ".jp-chip"
  },
  "states": [
    {
      "name": "hp-hover",
      "actions": [{"hover": ".hp-card[aria-pressed='false']"}, {"wait": 200}],
      "roles": {"hp-card-hover": ".hp-card[aria-pressed='false']:hover"}
    },
    {
      "name": "range-focus",
      "actions": [{"focus": "#areaSlider"}, {"wait": 100}, {"key": "rangeThumbFocus", "evalStore": "(() => { const cs = getComputedStyle(document.querySelector('#areaSlider'), '::-webkit-slider-thumb'); return { shadow: cs.boxShadow, outline: getComputedStyle(document.querySelector('#areaSlider')).outline }; })()"}],
      "roles": {}
    },
    {
      "name": "lead-open",
      "actions": [{"click": "#ctaBtn"}, {"wait": 400}, {"click": ".lead-submit"}, {"wait": 300}, {"click": ".method summary"}, {"wait": 300}, {"shot": "inventering/skarmdumpar/energycalc-{vp}-state-leadform.png"}],
      "roles": {"lead-inline": ".lead-inline.open", "lead-inline-body": ".lead-inline-body", "lead-title": ".lead-title", "lead-sub": ".lead-sub", "lead-lbl": ".lead-lbl", "lead-req": ".lead-req", "lead-field": "#leadName", "lead-field-invalid": ".lead-field[aria-invalid='true']", "lead-form-grid": "#leadForm", "lead-submit": ".lead-submit", "lead-consent": ".lead-consent", "lead-consent-a": ".lead-consent a", "lead-err": ".lead-err:not([hidden])", "leadclose": ".leadclose", "cta-is-close": "#ctaBtn.is-close", "method-body": ".method-body", "method-list-li": ".method-list li", "method-legal": ".method-legal", "method-open-summary": ".method[open] summary"}
    },
    {
      "name": "lead-focus",
      "actions": [{"focus": "#leadPhone"}, {"wait": 100}],
      "roles": {"lead-field-focus": "#leadPhone:focus-visible"}
    },
    {
      "name": "share-open",
      "actions": [{"click": "#shareBtn"}, {"wait": 300}, {"shot": "inventering/skarmdumpar/energycalc-{vp}-state-share.png", "full": false}],
      "roles": {"share-pop": ".share-pop:not([hidden])", "share-act": ".share-act", "share-act-svg": ".share-act svg"}
    }
  ]
}
