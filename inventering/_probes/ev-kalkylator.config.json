      "name": "tip-open",
      "actions": [{"click": "#ampyEvChargerButtonA"}, {"wait": 100}, {"click": ".ampy-calc__tip"}, {"wait": 300}, {"shot": "inventering/skarmdumpar/ev-kalkylator-{vp}-state-popover.png", "full": false}],
      "roles": {"popover": ".ampy-calc__popover[data-open]", "tip-active": ".ampy-calc__tip[aria-expanded='true']"}
    },
    {
      "name": "lead-form-open",
      "actions": [{"press": "Escape"}, {"click": "#ampyEvCtaQuote"}, {"wait": 350}, {"click": "#ampyEvLeadSubmit"}, {"wait": 300}, {"click": ".ampy-calc__disclosure-summary"}, {"wait": 200}, {"shot": "inventering/skarmdumpar/ev-kalkylator-{vp}-state-leadform.png"}],
      "roles": {"lead-form": "#ampyEvLeadForm", "lead-grid": ".ampy-calc__lead-form-grid", "lead-label": "label[for='ampyEvLeadName']", "lead-input": "#ampyEvLeadName", "lead-input-error-msg": "#ampyEvLeadNameError", "consent-row": ".ampy-calc__consent-row", "consent-check": "#ampyEvLeadConsent", "consent-text": "#ampyEvLeadConsentNotice", "consent-link": "#ampyEvLeadConsentNotice a", "lead-submit": "#ampyEvLeadSubmit", "cta-hidden": "#ampyEvCtaQuote", "methodology-item-h3": ".ampy-calc__methodology-item h3", "methodology-item-p": ".ampy-calc__methodology-item p", "methodology-code": ".ampy-calc__methodology-item code", "disclaimers": ".ampy-calc__disclaimers"}
    }
  ]
