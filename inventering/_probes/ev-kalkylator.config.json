      "roles": {}
    },
    {
      "name": "charger-open",
      "actions": [{"click": "#ampyEvChargerButtonA"}, {"wait": 300}, {"shot": "inventering/skarmdumpar/ev-kalkylator-{vp}-state-selector.png", "full": false}],
